# Ignorar todos los archivos dentro de la carpeta
data/horarios_cercanias/*

# Evitar ignorar el archivo .gitkeep para que Git suba la carpeta
!data/horarios_cercanias/.gitkeep

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
bin/"data/"

jcode-windows-x86_64.exe
%WIKI_DIR%
.metadata/
# Proyecto antiguo de terminal (ya no está en el repositorio): que Eclipse no vuelva a subir nada
files/Java/

# Base de datos local de usuarios H2 (R12)
**/data/usuarios_db*
*.mv.db