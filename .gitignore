# Ignorar todos los archivos dentro de la carpeta
data/horarios_cercanias/*
src/Java/data/*

# Evitar ignorar el archivo .gitkeep para que Git suba la carpeta
!data/horarios_cercanias/.gitkeep
!src/Java/data/.gitkeep

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
bin/"data/" 
