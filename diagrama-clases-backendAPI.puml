    - minTransferTime: int
    + Transbordo(fromStopId, toStopId, transferType, minTransferTime)
    + getFromStopId() | getToStopId()
    + getTransferType() | getMinTransferTime()
  }

  class ServicioCalendario <<modelo>> {
    - serviceId: String
    - dias: boolean[7]
    - inicio: LocalDate
    - fin: LocalDate
    - fechasAnadidas: Set<LocalDate>
    - fechasEliminadas: Set<LocalDate>
    + ServicioCalendario(serviceId, dias, inicio, fin)
