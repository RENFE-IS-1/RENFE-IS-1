    + Linea(id, shortName, longName, color)
    + getId() | getShortName() | getLongName() | getColor()
  }

  class Viaje <<modelo>> {
    - id: String
    - routeId: String
    - serviceId: String
  - blockId: String
    - latitudActual: double
    - longitudActual: double
    + Viaje(id, routeId, serviceId)
  + Viaje(id, routeId, serviceId, blockId)
    + actualizarPosicion(lat: double, lon: double)
    + getId() | getRouteId() | getServiceId() | getBlockId()
  }

  class ParadaHorario <<modelo>> {
    - tripId: String
    - arrivalTime: int
    - departureTime: int
    - stopId: String
    - stopSequence: int
    + ParadaHorario(tripId, arrivalTime, departureTime, stopId, stopSequence)
    + compareTo(o: ParadaHorario): int
    + getTripId() | getArrivalTime() | getDepartureTime()
    + getStopId() | getStopSequence()
  }

  class Transbordo <<modelo>> {
    - fromStopId: String
    - toStopId: String
